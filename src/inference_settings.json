  "video_models": {
    "Index-AniSora_V3.2": {
      "id": "anisora",
      "name": "Index-AniSora V3.2",
      "type": "video",
      "category": "hentai",
      "description": "High-quality hentai video generation",
      
      "modes": {
        "t2v": {
          "label": "Text2Video",
          "description": "Generate video from text prompt",
          "requires_reference": false
        },
        "i2v": {
          "label": "Image2Video",
          "description": "Animate a single image",
          "requires_reference": true
